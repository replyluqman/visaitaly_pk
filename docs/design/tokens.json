{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "VisaItaly PK glass-lite tokens. Source of truth for Flutter ThemeExtension and CMS CSS variables. See DESIGN-SYSTEM.md.",
  "color": {
    "light": {
      "bg": { "base": "#EEF2F7" },
      "mesh": { "lagoon": "#5FD3D9", "indigo": "#7C8CFF", "terracotta": "#F2A27F", "opacity": 0.35 },
      "surface": { "glass": "rgba(255,255,255,0.62)", "tint": "rgba(255,255,255,0.82)", "solid": "#FFFFFF" },
      "stroke": { "glass": "rgba(255,255,255,0.70)", "hairline": "rgba(11,21,48,0.08)" },
      "text": { "primary": "#0B1530", "secondary": "#475069", "onBrand": "#FFFFFF" },
      "brand": { "lagoon": "#0E7C86", "terracotta": "#C8552D", "indigo": "#2B3A8C" },
      "status": { "notStarted": "#6B7489", "inProgress": "#2563EB", "ready": "#15803D", "issueFound": "#B42318", "notApplicable": "#9AA1B2" },
      "badge": { "blocking": "#B42318", "needsReview": "#B45309", "sourceUnderReview": "#6D28D9" }
    },
    "dark": {
      "bg": { "base": "#070D1F" },
      "mesh": { "lagoon": "#0E7C86", "indigo": "#2B3A8C", "terracotta": "#8A3A1E", "opacity": 0.45 },
      "surface": { "glass": "rgba(18,26,52,0.58)", "tint": "rgba(20,29,58,0.86)", "solid": "#111A33" },
      "stroke": { "glass": "rgba(255,255,255,0.10)", "hairline": "rgba(255,255,255,0.06)" },
      "text": { "primary": "#F2F5FB", "secondary": "#A9B3CC", "onBrand": "#04121A" },
      "brand": { "lagoon": "#3CC4CC", "terracotta": "#F08A5D", "indigo": "#8C9BFF" },
      "status": { "notStarted": "#8D96AD", "inProgress": "#6EA0FF", "ready": "#4ADE80", "issueFound": "#FF7A70", "notApplicable": "#5D6680" },
      "badge": { "blocking": "#FF7A70", "needsReview": "#FBBF24", "sourceUnderReview": "#C4B5FD" }
    }
  },
  "blur": { "bar": 20, "sheet": 24, "hero": 16, "paywall": 24, "maxConcurrent": 2 },
  "radius": { "sm": 10, "md": 16, "lg": 22, "xl": 28, "pill": 999 },
  "space": [4, 8, 12, 16, 20, 24, 32, 40],
  "gutter": 16,
  "type": {
    "family": { "latin": "Inter", "urdu": "Noto Nastaliq Urdu" },
    "display": { "size": 28, "line": 34, "weight": 700 },
    "title": { "size": 20, "line": 26, "weight": 650 },
    "headline": { "size": 17, "line": 24, "weight": 600 },
    "body": { "size": 15, "line": 22, "weight": 400 },
    "label": { "size": 13, "line": 18, "weight": 550 },
    "caption": { "size": 12, "line": 16, "weight": 500 },
    "maxScale": 1.3
  },
  "motion": {
    "sharedAxisMs": 300,
    "readinessTweenMs": 600,
    "statusChangeMs": 200,
    "curve": "emphasizedDecelerate"
  },
  "perfTier": {
    "fullMinRamGb": 4,
    "fullMinAndroidSdk": 29,
    "frameDropThreshold": 0.10,
    "frameSampleSize": 120
  }
}

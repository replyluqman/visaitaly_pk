{
  "name": "@visaitaly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "migrate": "node scripts/migrate.mjs up",
    "rollback": "node scripts/migrate.mjs down",
    "preflight": "node scripts/preflight.mjs",
    "migrate:roundtrip": "node scripts/migrate-roundtrip.mjs",
    "migrate:status": "node scripts/migrate.mjs status",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "gate4": "node scripts/gate4.mjs"
  },
  "dependencies": {
    "@visaitaly/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "firebase-auth-cloudflare-workers": "^2.0.6",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2",
    "wrangler": "^3.91.0"
  }
}

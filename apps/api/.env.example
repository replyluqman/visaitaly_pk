# Used by scripts/migrate.mjs and scripts/preflight.mjs — NOT by the Worker.
#
# Must be a DIRECT Postgres connection string, never Hyperdrive. Hyperdrive is
# the Worker's pooled runtime read path; migrations are DDL run from a developer
# machine or CI and must not go through a pooler.
#
# Local:       postgres://postgres:postgres@localhost:5433/visaitaly
# Neon (dev):  the direct (non-pooled) connection string from the Neon dashboard
#
# Never commit a real value. Never point this at production from a laptop —
# production migrations run from CI or a controlled release step
# (docs/DEPLOYMENT.md).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/visaitaly

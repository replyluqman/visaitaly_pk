    "ask": [
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:rollback *)",
      "Bash(pnpm db:rollback)",
      "Bash(pnpm api:deploy:staging *)",
      "Bash(pnpm api:deploy:staging)"
